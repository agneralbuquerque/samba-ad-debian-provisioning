# Configurações do ambiente - copie para config.env e ajuste os valores
# NÃO faça commit do config.env com dados sensíveis reais (está no .gitignore)

# --- Rede / Hostname ---
NEW_HOSTNAME="arquivos.novocliente.local"
STATIC_IP="192.168.1.10/24"
GATEWAY="192.168.1.1"
INTERFACE="ens18"                 # ajuste conforme `ip a s`
DNS_PRIMARY="192.168.1.2"         # IP do DC / AD
DNS_SECONDARY="8.8.8.8"

# --- Domínio / Active Directory ---
DOMAIN_REALM="NOVOCLIENTE.LOCAL"      # REALM em maiúsculas (Kerberos)
DOMAIN_SHORT="NOVOCLIENTE"            # Nome NetBIOS do domínio
DC_FQDN="dc01.novocliente.local"      # FQDN do Domain Controller
DC_IP="192.168.1.2"
AD_JOIN_USER="Administrator"          # usuário com permissão de ingressar no domínio

# --- Firewall (serviços liberados via firewalld) ---
FIREWALL_SERVICES="cockpit samba kerberos dns ssh"

# --- Disco/armazenamento adicional (ajuste ou deixe em branco para pular) ---
DATA_DISK=""                # ex: /dev/sdb  (deixe vazio se não houver disco extra)
DATA_MOUNT="/work0"

# --- Compartilhamentos e grupos AD ---
# Formato de cada entrada: "nome_share:path:grupo_ad:modo:comentario"
# modo: rw (create 0660/dir 2770, força grupo) | publico (0664/2775, valid users = @domain users)
#       | restrito (0640/2750, browseable=no, força grupo)
SHARE_MAP=(
  "docs_digitais:$DATA_MOUNT/docs_digitais::publico:Documentos Digitais"
  "suporte:$DATA_MOUNT/SUPORTE:suporte:rw:Suporte"
  "lixeira:$DATA_MOUNT/lixeira::publico:Lixeira Geral"
  "RCPN:$DATA_MOUNT/dados/PESSOAS_NATURAIS:rcpn:rw:RCPN"
  "NOTAS:$DATA_MOUNT/dados/NOTAS:notas:rw:NOTAS"
  "PJ:$DATA_MOUNT/dados/SETOR_PJ:pj:rw:PJ"
  "FINANCEIRO:$DATA_MOUNT/dados/FINANCEIRO:financeiro:rw:Financeiro"
  "DIGITALIZACAO:$DATA_MOUNT/dados/DIGITALIZACAO:digitalizacao:rw:Digitalização"
  "GABINETE:$DATA_MOUNT/dados/GABINETE:gabinete:restrito:Gabinete"
  "SUBSTITUTO:$DATA_MOUNT/dados/SUBSTITUTO:substituto:rw:Tabelião Substituto"
  "MEDIA:$DATA_MOUNT/MEDIA:media:rw:Media"
)

# --- Recycle bin nativo do Samba (VFS recycle) ---
SAMBA_RECYCLE_PATH="$DATA_MOUNT/lixeira"


# --- Zabbix (opcional) ---
INSTALL_ZABBIX=false
ZABBIX_SERVER_IP=""
ZABBIX_HOSTNAME=""

# --- DataSafer (backup, opcional) ---
INSTALL_DATASAFER=false
