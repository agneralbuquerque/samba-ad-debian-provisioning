# Configurações para provisionar este Debian 13 como Active Directory Domain
# Controller (Samba AD DC) — use quando NÃO existir Windows Server/DC prévio.
# Copie para config-dc.env e ajuste os valores.
# NÃO faça commit deste arquivo com dados reais do cliente (está no .gitignore)

# --- Rede / Hostname ---
NEW_HOSTNAME="dc01.ferreiragomes.lan"
STATIC_IP="192.168.0.10/24"
GATEWAY="192.168.0.1"
INTERFACE="ens18"                 # ajuste conforme `ip a s`
DNS_FORWARDER="8.8.8.8"           # DNS upstream para resolução de internet (forwarder do Samba DNS)

# --- Domínio / Active Directory (novo domínio, provisionado do zero) ---
DOMAIN_REALM="FERREIRAGOMES.LAN"      # REALM em maiúsculas (Kerberos)
DOMAIN_SHORT="FERREIRAGOMES"          # Nome NetBIOS do domínio (workgroup), até 15 caracteres
# Senha do Administrator do domínio. Requisitos do Samba: min. 8 caracteres,
# maiúsculas+minúsculas+números+símbolo. Deixe em branco para digitar interativamente.
ADMIN_PASSWORD=""

# --- Firewall (serviços liberados via firewalld) ---
FIREWALL_SERVICES="cockpit ssh dns kerberos kpasswd ldap ldaps samba samba-dc"

# --- Disco/armazenamento adicional (ajuste ou deixe em branco para pular) ---
DATA_DISK=""                # ex: /dev/sdb  (deixe vazio se não houver disco extra)
DATA_MOUNT="/work0"

# --- Compartilhamentos e grupos do domínio (criados automaticamente via samba-tool) ---
# Formato de cada entrada: "nome_share:path:grupo_ad:modo:comentario"
# modo: rw (create 0660/dir 2770, força grupo) | publico (0664/2775, valid users = @domain users)
#       | restrito (0640/2750, browseable=no, força grupo)
SHARE_MAP=(
  "cartorio:$DATA_MOUNT/dados/cartorio:tabeliao:rw:Geral do Cartório"
  "lixeira:$DATA_MOUNT/lixeira::publico:Lixeira Geral"
)

# --- Recycle bin nativo do Samba (VFS recycle) ---
SAMBA_RECYCLE_PATH="$DATA_MOUNT/lixeira"
